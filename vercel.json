{
  "version": 2,
  "functions": {
    "api/notify.js": { "maxDuration": 10 },
    "api/dashboard.js": { "maxDuration": 10 },
    "api/webhook-inventory.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/api/notify",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-notify-secret" }
      ]
    }
  ]
}
