# Copy to .env.local for local dev; add these in Vercel dashboard → Settings → Environment Variables

# Shopify Admin API
SHOPIFY_STORE=claura-in                  # the part before .myshopify.com
SHOPIFY_API_VERSION=2024-10
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # from webhook subscription create response

# Dashboard
DASHBOARD_PIN=changeme2026

# ConvertWay WhatsApp — fill in with your real wishlist-backend values
CONVERTWAY_API_URL=https://api.convertway.com/send
CONVERTWAY_API_KEY=your_convertway_api_key_here

# Used as a fallback if a product_url wasn't stored with the entry
STORE_DOMAIN=claura.in
